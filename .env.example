# Database (PostgreSQL via Supabase or Railway)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/peptora

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-256-bit-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Payments — NOWPayments (crypto only; there is no card processor)
# Both are required before checkout is offered at all: the API key alone would
# let users pay while every callback failed verification, so nobody is credited.
# The IPN secret is a SEPARATE value from the API key, found under
# Payment Settings -> IPN once the callback URL is saved.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Sandbox: https://api-sandbox.nowpayments.io/v1
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1

# Where NOWPayments sends IPN callbacks. Must be this API's own origin, never
# WEB_URL — the web app proxies /api/* through Vercel and the IPN signature is
# computed over raw bytes, so the extra hop breaks verification.
API_PUBLIC_URL=https://api.peptora.io

# Access
# The 14-day trial is granted once per device at email verification. After it,
# Peptora is a ONE-TIME purchase verified by hand — see app/routers/billing.py.
TRIAL_DAYS=14

# Seed only. The live one-time price lives in the app_settings table and is
# edited from the admin panel, so changing it never needs a redeploy.
PRICE_ONETIME_USD=99

# Dormant crypto rail. Also requires app_settings.crypto_payments_enabled.
PRICE_MONTHLY_USD=5
PRICE_ANNUAL_USD=49

# Payment receipts — Railway Bucket (private, S3-compatible). Reference these
# from the bucket in the Railway dashboard; leave blank locally and
# app/utils/storage.py falls back to a directory on disk.
RECEIPTS_BUCKET=
RECEIPTS_ENDPOINT=
RECEIPTS_REGION=
RECEIPTS_ACCESS_KEY_ID=
RECEIPTS_SECRET_ACCESS_KEY=

# Receipts are financial PII. Objects are purged this long after review by the
# billing sweep; the claim metadata is kept as the record of the decision.
RECEIPT_RETENTION_DAYS=365

# AI
ANTHROPIC_API_KEY=sk-ant-...

# Email
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@peptora.app

# App
# WEB_URL / ADMIN_URL are auto-added to the CORS allow-list. Both accept an
# https:// origin, or an http:// one when the host is localhost/127.0.0.1 —
# pointing WEB_URL at localhost also switches cookies to SameSite=Lax without
# Secure, so auth works over plain http. No trailing slash or path.
WEB_URL=https://peptora.io
ADMIN_URL=https://admin.peptora.io
CORS_ORIGINS=https://peptora.io,https://www.peptora.io,https://admin.peptora.io
ENVIRONMENT=production

# For local dev, copy this file to .env.local (git-ignored, overrides .env):
#   WEB_URL=http://localhost:3000
#   ADMIN_URL=http://localhost:3001
#   ENVIRONMENT=development
